#!/usr/bin/env bash
# Usage: stats-detail <cpu|ram|net|disk|gpu> [disk-mount] prints that card's JSON; stats-detail device [disk-mount] the mount's disk name.
set -u  # not -e: a failed probe must only blank its own field

SECTION="${1:-}"
MOUNT="${2:-/}"

disk_of() { lsblk -sno NAME,TYPE "$1" 2>/dev/null | awk '$2=="disk"{ sub(/^[^a-zA-Z0-9]*/, "", $1); print $1; exit }'; }
source_of() { findmnt -n -o SOURCE --target "$1" | sed 's/\[.*//'; }

top() { ps -eo comm=,"$1"= --sort=-"$1" | head -5 | jq -R -s -c 'split("\n") | map(select(length>0) | capture("^(?<name>.*?)\\s+(?<value>[0-9.]+)$") | .value |= tonumber)'; }

# The program's file name, so a browser's helper processes count as the browser; the process name for
# programs whose file is named after a version (2.1.314) or that cannot be read.
program_name() {
  local exe name
  exe=$(readlink "/proc/$1/exe" 2>/dev/null)
  exe=${exe% (deleted)}
  name=${exe##*/}
  [[ -n $name && ! $name =~ ^[0-9.]+$ ]] || name=$(cat "/proc/$1/comm" 2>/dev/null || echo "$1")
  echo "$name"
}

# "pid ticks" for every process: utime + stime from /proc/<pid>/stat (the name in parentheses may hold spaces).
cpu_ticks() {
  cat /proc/[0-9]*/stat 2>/dev/null | awk '{
    end = 0
    for (i = length($0); i > 0; i--) if (substr($0, i, 1) == ")") { end = i; break }
    n = split(substr($0, end + 2), f, " ")
    if (n >= 13) print $1, f[12] + f[13]
  }'
}

# Current CPU use per program, as a share of all cores: the change in CPU time since the previous run's snapshot,
# or over half a second when that snapshot is missing or older than 10 s. A process started since counts all its time.
top_cpu_now() {
  local state="${XDG_RUNTIME_DIR:-/tmp}/omarchy-stats-cpu-ticks"
  local now prev_time=0 hz threads
  hz=$(getconf CLK_TCK)
  threads=$(nproc)
  [[ -r $state ]] && read -r prev_time <"$state"
  now=$(date +%s%N)
  if (( now - prev_time > 10000000000 )); then
    { echo "$now"; cpu_ticks; } >"$state"
    sleep 0.5
    now=$(date +%s%N)
  fi
  local current
  current=$(cpu_ticks)
  awk -v hz="$hz" -v threads="$threads" -v seconds="$(( (now - $(head -1 "$state")) / 1000000 ))" '
    NR == FNR { if (FNR > 1) before[$1] = $2; next }
    { used = $2 - ($1 in before ? before[$1] : 0) }
    used > 0 { printf "%s %.4f\n", $1, used / hz / (seconds / 1000) / threads * 100 }
  ' "$state" <(echo "$current") | sort -k2 -nr | head -20 |
    while read -r pid share; do
      name=$(program_name "$pid")
      printf '%s\t%s\n' "$name" "$share"
    done |
    jq -R -s -c 'split("\n") | map(select(length > 0) | split("\t") | {name: .[0], value: (.[1] | tonumber)})
      | group_by(.name) | map({name: .[0].name, value: (map(.value) | add)}) | sort_by(-.value) | .[:5]'
  { echo "$now"; echo "$current"; } >"$state"
}

case $SECTION in
  device | --device)
    src=$(source_of "$MOUNT")
    dev=$(disk_of "$src")
    echo "${dev:-$(basename "$src")}"
    ;;

  cpu)
    read -r load1 load5 load15 _ </proc/loadavg
    freq=$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null | awk '{s+=$1; n++} END{ printf "%d", (n ? s/n*1000 : 0) }')
    uptime_s=$(awk '{printf "%d", $1}' /proc/uptime)
    jq -n -c --argjson load1 "$load1" --argjson load5 "$load5" --argjson load15 "$load15" \
      --argjson freq "${freq:-0}" --argjson uptime "${uptime_s:-0}" --argjson top "$(top_cpu_now)" \
      '{load: [$load1, $load5, $load15], frequency: $freq, uptime: $uptime, top: $top}'
    ;;

  ram)
    read -r mem_total mem_free mem_avail app cache swap_total swap_free < <(awk '
      /^MemTotal:/{t=$2} /^MemFree:/{f=$2} /^MemAvailable:/{a=$2} /^AnonPages:/{an=$2}
      /^Cached:/{c=$2} /^Buffers:/{b=$2} /^SReclaimable:/{sr=$2}
      /^SwapTotal:/{st=$2} /^SwapFree:/{sf=$2}
      END{ print t*1024, f*1024, a*1024, an*1024, (c+b+sr)*1024, st*1024, sf*1024 }' /proc/meminfo)
    pressure=$(awk '/^some/{ split($2, a, "="); print a[2]; exit }' /proc/pressure/memory 2>/dev/null || echo 0)
    jq -n -c --argjson total "$mem_total" --argjson free "$mem_free" --argjson avail "$mem_avail" \
      --argjson app "$app" --argjson cache "$cache" --argjson swapTotal "$swap_total" --argjson swapFree "$swap_free" \
      --argjson pressure "${pressure:-0}" --argjson top "$(top rss)" \
      '{total: $total, used: ($total - $avail), app: $app, cache: $cache, free: $free,
        swapTotal: $swapTotal, swapUsed: ($swapTotal - $swapFree), pressure: $pressure,
        top: ($top | map(.value *= 1024))}'
    ;;

  net)
    route=$(ip -o route get 1.1.1.1 2>/dev/null)
    iface=$(awk '{for(i=1;i<NF;i++) if($i=="dev"){print $(i+1); exit}}' <<<"$route")
    local_ip=$(awk '{for(i=1;i<NF;i++) if($i=="src"){print $(i+1); exit}}' <<<"$route")
    mac=$(cat "/sys/class/net/$iface/address" 2>/dev/null || true)
    dns=$(resolvectl dns 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9a-f.:]+$/ && $i != "127.0.0.53" && $i ~ /[.:]/){print $i; exit}}')
    [[ -n $dns ]] || dns=$(awk '/^nameserver/ && $2 != "127.0.0.53" {print $2; exit}' /etc/resolv.conf)
    net_rx=$(cat "/sys/class/net/$iface/statistics/rx_bytes" 2>/dev/null || echo 0)
    net_tx=$(cat "/sys/class/net/$iface/statistics/tx_bytes" 2>/dev/null || echo 0)
    jq -n -c --arg iface "${iface:-}" --arg ip "${local_ip:-}" --arg mac "${mac:-}" --arg dns "${dns:-}" \
      --argjson rx "${net_rx:-0}" --argjson tx "${net_tx:-0}" \
      '{interface: $iface, ip: $ip, mac: $mac, dns: $dns, totalDownload: $rx, totalUpload: $tx}'
    ;;

  disk)
    # One entry per mounted partition; btrfs subvolumes of one partition count once, under their shortest mount.
    main=$(source_of "$MOUNT")
    rows=$(findmnt -rn -o SOURCE,TARGET,FSTYPE | awk '$1 ~ /^\/dev\// { sub(/\[.*/, "", $1); print length($2), $1, $2, $3 }' | sort -n | {
      declare -A seen
      while read -r _ source target fstype; do
        target=$(printf '%b' "$target")
        [[ -n ${seen[$source]:-} ]] && continue
        seen[$source]=1
        disk=$(disk_of "$source")
        part=$(lsblk -sno NAME,TYPE "$source" 2>/dev/null | awk '$2=="part"{ sub(/^[^a-zA-Z0-9]*/, "", $1); print $1; exit }')
        read -r total used free < <(df -PB1 "$target" 2>/dev/null | awk 'NR==2{print $2, $3, $4}')
        model=$(sed 's/ *$//' "/sys/block/$disk/device/model" 2>/dev/null)
        data='' meta='' sys=''
        if [[ $fstype == btrfs ]]; then
          read -r data meta sys < <(btrfs filesystem df -b "$target" 2>/dev/null |
            awk -F'used=' '/^Data/{d=$2+0} /^Metadata/{m=$2+0} /^System/{s=$2+0} END{print d+0, m+0, s+0}')
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$target" "$source" "$fstype" "$disk" "$model" \
          "${total:-0}" "${used:-0}" "${free:-0}" "${part:-}" "$data" "$meta" "$sys"
      done
    })
    blocks=$(lsblk -bnro NAME,SIZE,TYPE,FSTYPE,LABEL,PKNAME 2>/dev/null)
    jq -R -s -c --arg main "$main" --arg blocks "$blocks" '
      ($blocks | split("\n") | map(select(length > 0) | split(" ")
        | {name: .[0], size: (.[1] | tonumber? // 0), type: .[2], fstype: .[3], label: (.[4] | gsub("\\\\x20"; " ")), parent: .[5]})) as $all
      | ($all | map(select(.type == "disk")) | map(. as $d | {key: $d.name, value: {size: $d.size,
          parts: ([$all[] | select(.type == "part" and .parent == $d.name)
            | {name, size, fstype, label}])}}) | from_entries) as $layouts
      | {source: $main,
         drives: (split("\n") | map(select(length > 0) | split("\t")
           | {mount: .[0], source: .[1], fstype: .[2], disk: .[3], model: .[4],
              total: (.[5] | tonumber), used: (.[6] | tonumber), free: (.[7] | tonumber), partition: .[8],
              breakdown: (if .[9] != "" then {kind: "btrfs", data: (.[9] | tonumber), metadata: (.[10] | tonumber), system: (.[11] | tonumber)}
                          else {kind: "plain"} end),
              layout: ($layouts[.[3]] // null)}))}' <<<"$rows"
    ;;

  gpu)
    gpu_top='[]'
    if command -v nvidia-smi >/dev/null; then
      gpu_top=$(nvidia-smi pmon -c 1 -s m 2>/dev/null |
        awk '!/^#/ && $2 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ { print $2, $4 }' |
        while read -r pid mb; do
          name=$(program_name "$pid")
          printf '%s\t%s\n' "$name" "$((mb * 1048576))"
        done |
        jq -R -s -c 'split("\n") | map(select(length > 0) | split("\t") | {name: .[0], value: (.[1] | tonumber)})
          | group_by(.name) | map({name: .[0].name, value: (map(.value) | add)}) | sort_by(-.value) | .[:5]')
    fi
    jq -n -c --argjson top "${gpu_top:-[]}" '{top: $top}'
    ;;

  *)
    echo "usage: stats-detail <cpu|ram|net|disk|gpu|device> [disk-mount]" >&2
    exit 2
    ;;
esac
